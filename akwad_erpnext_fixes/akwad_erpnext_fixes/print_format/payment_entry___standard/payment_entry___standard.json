 "font_size": 14,
 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n{% if doc.payment_type == \"Receive\" %}\n    <h1 class=\"pf-heading pf-color\">Payment Receipt</h1>\n{% elif doc.payment_type == \"Pay\" %}\n    <h1 class=\"pf-heading pf-color\">Payment Voucher</h1>\n{% elif doc.payment_type == \"Internal Transfer\" %}\n    <h1 class=\"pf-heading pf-color\">Internal Transfer Voucher</h1>\n{% else %}\n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n{% endif %}\n    \n<table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n    <tbody>\n        {% if doc.mode_of_payment %}\n            <tr>\n                <td class=\"pf-color\" style=\"width: 30%;\">\n                    <p>Mode of Payment</p>\n                </td>\n                <td style=\"width: 40%; text-align: center;\">\n                    <p>{{ doc.mode_of_payment }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>طريقة الدفع</p>\n                </td>\n            </tr>\n        {% endif %}\n\n        {% if doc.party_type %}\n            <tr>\n                <td class=\"pf-color\" style=\"width: 30%;\">\n                    <p>Party Type</p>\n                </td>\n                <td style=\"width: 40%; text-align: center;\">\n                    <p>{{ doc.party_type }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>نوع الحساب</p>\n                </td>\n            </tr>\n        {% endif %}\n\n        {% if doc.party_name %}\n            <tr>\n                <td class=\"pf-color\" style=\"width: 30%;\">\n                    <p>\n                        {% if doc.payment_type == \"Receive\" %}\n                            Received From\n                        {% elif doc.payment_type == \"Pay\" %}\n                            Pay To\n                        {% else %}\n                            Party Name\n                        {% endif %}\n                    </p>\n                </td>\n                <td style=\"width: 40%; text-align: center;\">\n                    <p>{{ doc.party_name }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>\n                        {% if doc.payment_type == \"Receive\" %}\n                            تم الاستلام من\n                        {% elif doc.payment_type == \"Pay\" %}\n                            تم الدفع لـ\n                        {% else %}\n                            اسم الحساب\n                        {% endif %}\n                    </p>\n                </td>\n            </tr>\n        {% endif %}\n\n        <tr>\n            <td class=\"pf-color\" style=\"width: 30%;\">\n                <p>Posting Date</p>\n            </td>\n            <td style=\"width: 40%; text-align: center;\">\n                <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                <p>تاريخ القيد</p>\n            </td>\n        </tr>\n\n        <tr>\n            <td class=\"pf-color\" style=\"width: 30%;\">\n                <p>Payment Reference</p>\n            </td>\n            <td style=\"width: 40%; text-align: center;\">\n                <p>{{ doc.name }}</p>\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                <p>رقم مرجع الدفع</p>\n            </td>\n        </tr>\n    </tbody>\n</table>\n{% if doc.payment_type == \"Internal Transfer\" %}\n\n<table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n    <thead>\n        <tr style=\"background-color: {{ color }};\">\n            <th style=\"width: 40%;\">Account<br>الحساب</th>\n            <th style=\"width: 30%;\">Debit<br>مدين</th>\n            <th style=\"width: 30%;\">Credit<br>دائن</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr style=\"border: 3px solid {{ color }};\">\n            <td style=\"text-align: center;\">{{ doc.paid_to }}</td>\n            <td style=\"text-align: center;\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n            <td style=\"text-align: center;\">0</td>\n        </tr>\n        <tr style=\"border: 3px solid {{ color }};\">\n            <td style=\"text-align: center;\">{{ doc.paid_from }}</td>\n            <td style=\"text-align: center;\">0</td>\n            <td style=\"text-align: center;\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n        </tr>\n    </tbody>\n</table>\n\n{% else %}\n\n    <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"width: 25%;\">Reference or Cheque No.<br>رقم الشيك أو المرجع</th>\n                <th style=\"width: 25%;\">Date<br>التاريخ</th>\n                <th style=\"width: 25%;\">Amount<br>المبلغ</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr style=\"border: 3px solid {{ color }};\">\n                <td style=\"text-align: center;\">{{ doc.reference_no }}</td>\n                <td style=\"text-align: center;\">{{ doc.get_formatted(\"reference_date\") }}</td>\n                <td style=\"text-align: center;\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n            </tr>\n        </tbody>\n    </table>\n    {% endif %}\n    <p style=\"width: 100%; text-align: right;\">In Words: {{ doc.in_words }}</p>\n    \n    {% if doc.references %}\n    <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"width: 20%;\">Reference Type<br>نوع المرجع</th>\n                <th style=\"width: 20%;\">Name<br>رقم المرجع</th>\n                <th style=\"width: 20%;\">Total Amount<br>االمبلغ الإجمالي</th>\n                <th style=\"width: 20%;\">Allocated Amount<br>المبلغ المخصص</th>\n                <th style=\"width: 20%;\">Outstanding Amount<br>المبلغ المتبقي</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.references %}\n                <tr style=\"border: 3px solid {{ color }};\">\n                    <td style=\"text-align: center;\">{{ row.reference_doctype }}</td>\n                    <td style=\"text-align: center;\">{{ row.reference_name }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"total_amount\", doc) }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"allocated_amount\", doc) }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"outstanding_amount\", doc) }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    {% endif %}\n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n\n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">\n                 {{ get_qr_print_link(doc.doctype, doc.name,frappe.form_dict.print_format ) }}\n\n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.party_name %}\n                    Received By المستلم:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.payment_type == \"Receive\" %}\n                    {{ doc.company }}\n                {% elif doc.payment_type == \"Pay\" %}\n                    {{ doc.party_name }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.contact_person %}\n                    Mobile No رقم الجوال:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.contact_person %}\n                    {{ frappe.db.get_value(\"Contact\", doc.contact_person, \"mobile_no\") }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                Date التاريخ:\n            </td>\n            <td style=\"width: 30%;\">\n                {{ doc.get_formatted(\"posting_date\") }}\n            </td>\n        </tr>\n    </table>\n    \n    {% if doc.terms %}\n        <div class=\"pf-terms pf-font-size\">\n            <p><strong class=\"pf-color\">Terms and conditions</strong></p>\n            <br>\n            <p>{{ doc.terms }}</p>\n        </div>\n    {% endif %}\n    \n{% set include_signature = print_format_shows_signature(\"Payment Entry - Standard\") %}\n{% if include_signature %}\n    {% set workflow_signatures = get_workflow_signatures_for_print(doc.doctype, doc.name) %}\n    {% if workflow_signatures and workflow_signatures|length > 0 %}\n    <div class=\"pf-signatures\" style=\"margin-top: 40px; margin-bottom: 25px; text-align: center;\">\n        {% for step in workflow_signatures %}\n        <div style=\"display: inline-block; vertical-align: top; text-align: center; width: 160px; margin: 0 15px 15px 15px;\">\n            <div style=\"font-weight: bold; font-size: 13px;\">{{ step.user }}</div>\n            <div style=\"font-size: 12px; color: #555;\">{{ step.workflow_state }}</div>\n            <div style=\"margin-top: 8px; min-height: 50px;\">\n                {% if step.signature %}\n                    <img src=\"{{ step.signature }}\" style=\"max-width: 120px; max-height: 60px;\">\n                {% else %}\n                    <span style=\"font-size: 11px; color: #999;\">No Signature</span>\n                {% endif %}\n            </div>\n        </div>\n        {% endfor %}\n    </div>\n    {% endif %}\n{% endif %}\n\n\n    \n</div>\n\n{% if footer %}\n\t<div class=\"text-center footer small\">\n\t\t    {{footer}}\n\t</div>\n{% endif %}\n",
