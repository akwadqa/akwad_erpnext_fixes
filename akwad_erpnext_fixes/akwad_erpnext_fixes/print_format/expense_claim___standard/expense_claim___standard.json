 "font_size": 14,
 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 40%;\">\n                    <p>EMPLOYEE DETAILS:</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.employee_name }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Expense Claim # \u0627\u0644\u0631\u0642\u0645 </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.name }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.employee }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Posting Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    {% if doc.department %}\n                        <p>{{ doc.department }}</p>\n                    {% endif %}\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }}; border: 3px solid {{ color }};\">\n                <th style=\"text-align: left; width: 5%;\">No.<br>\u0645</th>\n                <th style=\"text-align: left; width: 19%;\">Expense Date<br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0635\u0631\u0648\u0641</th>\n                <th style=\"text-align: left; width: 28%;\">Expense Category<br>\u0646\u0648\u0639 \u0627\u0644\u0645\u0635\u0631\u0648\u0641</th>\n                <th style=\"text-align: left; width: 28%;\">Description<br>\u0627\u0644\u0648\u0635\u0641</th>\n                <th style=\"text-align: Center; width: 20%;\">Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for expense in doc.expenses %}\n                <tr>\n                    <td>{{ expense.idx }}</td>\n                    <td>{{ expense.expense_date }}</td>\n                    <td>\n                        <div style=\"border-bottom: 1px dashed black;\">\n                            Type: {{ expense.expense_type }}\n                        </div>\n                        <div style=\"border-bottom: 1px dashed black;\">\n                            Cost Center: {{ expense.cost_center }}\n                        </div>\n                        <div>\n                            Project: {{ frappe.db.get_value(\"Project\", expense.project, \"project_name\") }}\n                        </div>\n                    </td>\n                    <td>\n                        {{ expense.description }}\n                    </td>\n                    <td style=\"text-align: center;\">{{ expense.get_formatted(\"amount\", doc) }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.name }}&size=120x120\">\n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                Grand Total: {{ doc.get_formatted(\"grand_total\") }}\n            </td>\n        </tr>\n    </table>\n    \n    {% if footer %}\n        <div id=\"footer-html\" class=\"visible-pdf\">\n            {{ footer }}\n        </div>\n    {% endif %}\n    \n</div>",
