 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 40%;\">\n                    <p>EMPLOYEE DETAILS:</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.employee_name }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Expense Claim # الرقم </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.name }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.employee }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Posting Date تاريخ الاستلام </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    {% if doc.department %}\n                        <p>{{ doc.department }}</p>\n                    {% endif %}\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"width: 5%;\">No.<br>م</th>\n                <th style=\"width: 19%;\">Expense Date<br>تاريخ المصروف</th>\n                <th style=\"width: 28%;\">Expense Category<br>نوع المصروف</th>\n                <th style=\"width: 28%;\">Description<br>الوصف</th>\n                <th style=\"width: 20%;\">Amount<br>المبلغ</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for expense in doc.expenses %}\n                <tr style=\"border: 3px solid {{ color }};\">\n                    <td>{{ expense.idx }}</td>\n                    <td>{{ expense.expense_date }}</td>\n                    <td>\n                        <div>\n                            Type: {{ expense.expense_type }}\n                        </div>\n                        {% if expense.cost_center %}\n                            <div style=\"border-top: 1px dashed black;\">\n                                Cost Center: {{ expense.cost_center }}\n                            </div>\n                        {% endif %}\n                        {% if expense.project %}\n                            <div style=\"border-top: 1px dashed black;\">\n                                Project: {{ frappe.db.get_value(\"Project\", expense.project, \"project_name\") }}\n                            </div>\n                        {% endif %}\n                    </td>\n                    <td>\n                        {{ expense.description }}\n                    </td>\n                    <td style=\"text-align: center;\">{{ expense.get_formatted(\"amount\", doc) }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n \n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">  \n                {{ get_qr_print_link(doc.doctype, doc.name, doc.print_format_name or frappe.form_dict.print_format) }}  \n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                Grand Total: {{ doc.get_formatted(\"grand_total\") }}\n            </td>\n        </tr>\n    </table>\n    \n{% set include_signature = print_format_shows_signature(\"Expense Claim - Standard\") %}\n{% if include_signature %}\n    {% set workflow_signatures = get_workflow_signatures_for_print(doc.doctype, doc.name) %}\n    {% if workflow_signatures and workflow_signatures|length > 0 %}\n    <div class=\"pf-signatures\" style=\"margin-top: 40px; margin-bottom: 25px; text-align: center;\">\n        {% for step in workflow_signatures %}\n        <div style=\"display: inline-block; vertical-align: top; text-align: center; width: 160px; margin: 0 15px 15px 15px;\">\n            <div style=\"font-weight: bold; font-size: 13px;\">{{ step.user }}</div>\n            <div style=\"font-size: 12px; color: #555;\">{{ step.workflow_state }}</div>\n            <div style=\"margin-top: 8px; min-height: 50px;\">\n                {% if step.signature %}\n                    <img src=\"{{ step.signature }}\" style=\"max-width: 120px; max-height: 60px;\">\n                {% else %}\n                    <span style=\"font-size: 11px; color: #999;\">No Signature</span>\n                {% endif %}\n            </div>\n        </div>\n        {% endfor %}\n    </div>\n    {% endif %}\n{% endif %}\n\n\n    \n</div>\n\n{% if footer %}\n\t<div class=\"text-center footer small\">\n\t\t    {{footer}}\n\t</div>\n{% endif %}\n",
