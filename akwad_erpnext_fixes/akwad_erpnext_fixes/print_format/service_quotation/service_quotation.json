 "html": "<style>\r\n\r\n    .pf-font {\r\n        font-family: \"Rubik\", sans-serif;\r\n    }\r\n    \r\n    .pf-font-size {\r\n        font-size: 13.5px;\r\n    }\r\n    \r\n    .pf-color {\r\n        color: #00589c;\r\n    }\r\n    \r\n    .pf-billing-info {\r\n        padding:0;\r\n    }\r\n    \r\n    .pf-item-table {\r\n        width: 100%;\r\n        margin: 20px 0;\r\n    }\r\n    .pf-item-table td {\r\n        border: 3px solid #00589c;\r\n        vertical-align: middle!important;\r\n    }\r\n\r\n    .pf-item-table th {\r\n        font-weight: normal;\r\n        color: white;\r\n        text-align: center;\r\n    }\r\n    \r\n    \r\n</style>\r\n\r\n\r\n<div class=\"pf-font\">\r\n    \r\n    {% if letter_head %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n    \r\n    <h1 class=\"pf-color\" style=\"margin: 5px 0; width: 100%; text-align: center; text-transform: uppercase; font-size: 40px; font-weight: normal;\">\r\n    {{ doc.doctype }}\r\n    </h1>\r\n    \r\n<table style=\"font-size:13.5px; width: 100%; line-height: 1.4px;\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\" width: 40%;\">\r\n                    <p class=\"pf-color\">BILL TO:</p>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    <span>{{doc.contact_display}}</span>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <span class=\"pf-color\">QUOTATION # \u0631\u0642\u0645 \u0627\u0644\u0639\u0631\u0636</span>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <span>{{ doc.name }}</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    <span>{{ doc.customer_name }}</span>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <span class=\"pf-color\">Creation Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u0634\u0627\u0621</span>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <span>{{ doc.get_formatted(\"transaction_date\") }}</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    {% if doc.contact_mobile %}\r\n                        <span>{{ doc.contact_mobile }}</span>\r\n                    {% endif %}\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    {% if doc.valid_till %}\r\n                        <span class=\"pf-color\">Expiry Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u062a\u0647\u0627\u0621</span>\r\n                    {% endif %}\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    {% if doc.valid_till %}\r\n                        <span>{{ doc.get_formatted(\"valid_till\") }}</span>\r\n                    {% endif %}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n    \r\n    <table class=\"pf-font-size pf-item-table\" style=\"border: 3px solid #00589c;\">\r\n        <thead>\r\n            <tr style=\"background-color: #00589c\">\r\n                <th style=\"padding: 10px 5px !important; text-align: left; width: 80%;\">Required Services / \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody style=\"font-size: 12px;\">\r\n            {% for item in doc.items %}\r\n                <tr>\r\n                    <td style=\"padding-left:0;\">\r\n                        <strong>{{ item.item_name }}</strong>\r\n                        {% if item.description %}: \r\n                            <div style=\"display: block; text-align: left; margin: 8px 0; padding: 0;\">\r\n                                {{ item.description }}\r\n                            </div>\r\n                        {% endif %}\r\n                        <div style=\"align: left;\">\r\n                            <span style=\"display: inline-block; white-space: nowrap; background-color: #E7F1FF; padding: 6px; border-radius: 4px; text-align: center; min-width: fit-content;\">\r\n                                <strong>Amount <bdi>\u0627\u0644\u0645\u0628\u0644\u063a</bdi>: {{item.amount}} QAR</strong>\r\n                            </span>\r\n                            <span style=\"display: inline-block margin:6px\">&nbsp&nbsp</span>\r\n                            {% if item.custom_payment_type %}\r\n                                <span style=\"display: inline-block;  white-space: nowrap; background-color: #E7F1FF;padding: 6px; border-radius: 4px; text-align: center; min-width: 225px;\"> \r\n                                    <strong class=\"pf-color\"> {{ item.custom_payment_type }} </strong>\r\n                                </span>\r\n                            {% endif %}\r\n                        </div>\r\n                    </td>\r\n                </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n    \r\n    <table style=\"font-size: 13.5; width: 100%; line-height:0.8;\">\r\n\r\n        <tr>\r\n            <td rowspan=\"3\" style=\"width: 15%;\">  \r\n                {{ get_qr_print_link(doc.doctype, doc.name, doc.print_format_name or frappe.form_dict.print_format or frappe.form_dict.format or doc.name) }}  \r\n            </td>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                Subtotal \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0641\u0631\u0639\u064a\r\n            </td>\r\n            <td style=\"width: 30%; text-align: center; font-size:16px;\">\r\n                {{ doc.get_formatted(\"total\") }}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                Discount \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a\r\n            </td>\r\n            <td style=\"width: 30%; text-align: center; font-size:16px;\">\r\n                {{ doc.discount_amount }} ({{ doc.additional_discount_percentage }}%)\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                <span class=\"pf-color\">Grand Total \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a </span>\r\n            </td>\r\n            <td class=\"pf-color\" style=\"width: 30%; text-align: center; font-size:16px;\">\r\n                {{ doc.get_formatted(\"grand_total\") }}\r\n            </td>     \r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"4\" style=\"text-align: center; font-size:16px;\">\r\n                In Words: {{ doc.in_words }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    {% if doc.terms %}\r\n        <div style=\"margin-top: 100px;\">\r\n            <p class=\"pf-color\" style=\"font-size: 16px;\">Terms and conditions</p>\r\n            <p>{{ doc.terms }}</p>\r\n        </div>\r\n    {% endif %}\r\n    \r\n{% if footer %}\r\n\t<div id=\"footer-html\" class=\"footer visible-pdf\">\r\n\t\t    <div style=\"width: 100%; text-align: center;\">{{ footer }}</div>\r\n\t</div>\r\n{% endif %}\r\n    \r\n</div>",
