 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\r\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\r\n<style>\r\n    .pf-color {\r\n        color: {{ color }};\r\n    }\r\n</style>\r\n\r\n\r\n<div class=\"pf-font\">\r\n    \r\n    {% if letter_head %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n    \r\n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\r\n    \r\n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\r\n        <tbody>\r\n            <tr>\r\n                <td class=\"pf-color\" style=\"width: 40%;\">\r\n                    <p>BILL TO:</p>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    {% if doc.contact_display %} <p>{{doc.contact_display}}</p> {% else %} <p></p> {% endif %}\r\n                </td>\r\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\r\n                    <p>Invoice # \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</p>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <p>{{ doc.name }}</p>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    <p>{{ doc.customer_name }}</p>\r\n                </td>\r\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\r\n                    <p>Invoice Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</p>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"width: 40%; padding-left: 20px!important;\">\r\n                    {% if doc.contact_mobile %}\r\n                        <p>{{ doc.contact_mobile }}</p>\r\n                    {% endif %}\r\n                </td>\r\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\r\n                    <p>Due Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642</p>\r\n                </td>\r\n                <td style=\"width: 30%; text-align: right;\">\r\n                    <p>{{ doc.get_formatted(\"due_date\") }}</p>\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n    \r\n    {% set compact_item_print = frappe.db.get_single_value(\"Print Settings\", \"compact_item_print\") %}\r\n    \r\n    {% if compact_item_print %}\r\n        <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\r\n            <thead>\r\n                <tr style=\"background-color: {{ color }};\">\r\n                    <th style=\"width: 80%;\">Name / Description<br>\u0627\u0644\u0627\u0633\u0645 / \u0627\u0644\u0648\u0635\u0641</th>\r\n                    <th style=\"width: 20%;\">Amount (QAR)<br>\u0627\u0644\u0645\u0628\u0644\u063a (\u0631.\u0642)</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.items %}\r\n                    <tr style=\"border: 3px solid {{ color }};\">\r\n                        <td>\r\n                            <strong>{{ item.item_name }}</strong>{% if item.description %}: {{ item.description }}{% endif %}\r\n                        </td>\r\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"amount\", doc) }}</td>\r\n                    </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    {% else %}\r\n        <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\r\n            <thead>\r\n                <tr style=\"background-color: {{ color }};\">\r\n                    <th style=\"width: 5%;\">No.<br>\u0645</th>\r\n                    <th style=\"width: 35%;\">Name / Description<br>\u0627\u0644\u0627\u0633\u0645 / \u0627\u0644\u0648\u0635\u0641</th>\r\n                    <th style=\"width: 20%;\">QTY / UOM<br>\u0627\u0644\u0643\u0645\u064a\u0629 / \u0627\u0644\u0648\u062d\u062f\u0629</th>\r\n                    <th style=\"width: 20%;\">Unit Price<br>\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\r\n                    <th style=\"width: 20%;\">Amount (QAR)<br>\u0627\u0644\u0645\u0628\u0644\u063a (\u0631.\u0642)</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.items %}\r\n                    <tr style=\"border: 3px solid {{ color }};\">\r\n                        <td>{{ item.idx }}</td>\r\n                        <td>\r\n                            <strong>{{ item.item_name }}</strong>{% if item.description %}: {{ item.description }}{% endif %}\r\n                        </td>\r\n                        <td style=\"text-align: center;\">{{ item.qty }} {{ item.uom }}</td>\r\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"rate\", doc) }}</td>\r\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"amount\", doc) }}</td>\r\n                    </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    {% endif %}\r\n    \r\n    <table class=\"pf-font-size\" style=\"width: 100%;\">\r\n\r\n        <tr>\r\n            <td rowspan=\"3\" style=\"width: 25%;\">  \r\n                {{ get_qr_print_link(doc.doctype, doc.name, doc.print_format_name or frappe.form_dict.print_format) }}  \r\n            </td>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                Subtotal \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a\r\n            </td>\r\n            <td style=\"width: 30%; text-align: center;\">\r\n                {{ doc.get_formatted(\"total\") }}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                Discount \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a\r\n            </td>\r\n            <td style=\"width: 30%; text-align: center;\">\r\n                {{ doc.get_formatted(\"discount_amount\") }} ({{ doc.additional_discount_percentage }}%)\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"width: 12%;\">\r\n                \r\n            </td>\r\n            <td style=\"width: 33%;\">\r\n                <strong class=\"pf-color\">Grand Total \u0627\u0644\u0627\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a</strong>\r\n            </td>\r\n            <td class=\"pf-color\" style=\"width: 30%; text-align: center;\">\r\n                {{ doc.get_formatted(\"grand_total\") }}\r\n            </td>     \r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"4\" style=\"text-align: center;\">\r\n                In Words: <strong>{{ doc.in_words }}</strong>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    {% if doc.terms %}\r\n        <div class=\"pf-terms pf-font-size\">\r\n            <p><strong class=\"pf-color\">Terms and conditions</strong></p>\r\n            <br>\r\n            <p>{{ doc.terms }}</p>\r\n        </div>\r\n    {% endif %}\r\n    \r\n{% set include_signature = print_format_shows_signature(\"Sales Invoice - Standard\") %}\r\n{% if include_signature %}\r\n    {% set workflow_signatures = get_workflow_signatures_for_print(doc.doctype, doc.name) %}\r\n    {% if workflow_signatures and workflow_signatures|length > 0 %}\r\n    <div class=\"pf-signatures\" style=\"margin-top: 40px; margin-bottom: 25px; text-align: center;\">\r\n        {% for step in workflow_signatures %}\r\n        <div style=\"display: inline-block; vertical-align: top; text-align: center; width: 160px; margin: 0 15px 15px 15px;\">\r\n            <div style=\"font-weight: bold; font-size: 13px;\">{{ step.user }}</div>\r\n            <div style=\"font-size: 12px; color: #555;\">{{ step.workflow_state }}</div>\r\n            <div style=\"margin-top: 8px; min-height: 50px;\">\r\n                {% if step.signature %}\r\n                    <img src=\"{{ step.signature }}\" style=\"max-width: 120px; max-height: 60px;\">\r\n                {% else %}\r\n                    <span style=\"font-size: 11px; color: #999;\">No Signature</span>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n        {% endfor %}\r\n    </div>\r\n    {% endif %}\r\n{% endif %}\r\n\r\n    \r\n</div>\r\n\r\n{% if footer %}\r\n\t<div id=\"footer-html\" class=\"visible-pdf\">\r\n\t    <div class=\"letter-head-footer\">\r\n\t\t    {{footer}}\r\n\t    </div>\r\n\t</div>\r\n{% endif %}",
