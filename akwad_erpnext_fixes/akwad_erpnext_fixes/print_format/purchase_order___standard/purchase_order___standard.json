 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 40%;\">\n                    <p>SUPPLIER DETAILS:</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{doc.contact_display}}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>PO # رقم الطلب</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.name }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.supplier_name }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Request Date تاريخ الطلب</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.get_formatted(\"transaction_date\") }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    {% if doc.contact_mobile %}\n                        <p>{{ doc.contact_mobile }}</p>\n                    {% endif %}\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    {% if doc.schedule_date %}\n                        <p>Delivery Date تاريخ التسليم</p>\n                    {% endif %}\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    {% if doc.schedule_date %}\n                        <p>{{ doc.get_formatted(\"schedule_date\") }}</p>\n                    {% endif %}\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1; margin-top: 10px;\">\n        <tbody>\n            {% if doc.project %}\n                <tr>\n                    <td class=\"pf-color\" style=\"width: 50%; padding-left: 20px!important;\">\n                        <p>Project Name:</p>\n                    </td>\n                    <td style=\"width: 50%;\">\n                        <p>{{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") }}</p>\n                    </td>\n                </tr>\n            {% endif %}\n            {% if doc.set_warehouse %}\n                <tr>\n                    <td class=\"pf-color\" style=\"width: 50%; padding-left: 20px!important;\">\n                        <p>Warehouse:</p>\n                    </td>\n                    <td style=\"width: 50%;\">\n                        <p>{{ doc.set_warehouse }}</p>\n                    </td>\n                </tr>\n            {% endif %}\n        </tbody>\n    </table>\n    \n    {% set compact_item_print = frappe.db.get_single_value(\"Print Settings\", \"compact_item_print\") %}\n    \n    {% if compact_item_print %}\n        <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n            <thead>\n                <tr style=\"background-color: {{ color }};\">\n                    <th style=\"width: 80%;\">Name / Description<br>الاسم / الوصف</th>\n                    <th style=\"width: 20%;\">Amount (QAR)<br>المبلغ (ر.ق)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                    <tr style=\"border: 3px solid {{ color }};\">\n                        <td>\n                            <strong>{{ item.item_name }}</strong>{% if item.description %}: {{ item.description }}{% endif %}\n                        </td>\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"amount\", doc) }}</td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    {% else %}\n        <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n            <thead>\n                <tr style=\"background-color: {{ color }};\">\n                    <th style=\"width: 5%;\">No.<br>م</th>\n                    <th style=\"width: 35%;\">Name / Description<br>الاسم / الوصف</th>\n                    <th style=\"width: 20%;\">QTY / UOM<br>الكمية / الوحدة</th>\n                    <th style=\"width: 20%;\">Unit Price<br>سعر الوحدة</th>\n                    <th style=\"width: 20%;\">Amount (QAR)<br>المبلغ (ر.ق)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                    <tr style=\"border: 3px solid {{ color }};\">\n                        <td>{{ item.idx }}</td>\n                        <td>\n                            <strong>{{ item.item_name }}</strong>{% if item.description %}: {{ item.description }}{% endif %}\n                        </td>\n                        <td style=\"text-align: center;\">{{ item.qty }} {{ item.uom }}</td>\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"rate\", doc) }}</td>\n                        <td style=\"text-align: center;\">{{ item.get_formatted(\"amount\", doc) }}</td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    {% endif %}\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n  \n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">\n                {{ get_qr_print_link(doc.doctype, doc.name,frappe.form_dict.print_format ) }}\n\n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                Subtotal المجموع الفرعي\n            </td>\n            <td style=\"width: 30%; text-align: center;\">\n                {{ doc.get_formatted(\"total\") }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                Discount الخصومات\n            </td>\n            <td style=\"width: 30%; text-align: center;\">\n                {{ doc.get_formatted(\"discount_amount\") }} ({{ doc.additional_discount_percentage }}%)\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                <strong class=\"pf-color\">Grand Total الاجمالي الكلي</strong>\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: center;\">\n                {{ doc.get_formatted(\"grand_total\") }}\n            </td>     \n        </tr>\n        <tr>\n            <td colspan=\"4\" style=\"text-align: center;\">\n                In Words: <strong>{{ doc.in_words }}</strong>\n            </td>\n        </tr>\n    </table>\n    \n    {% if doc.terms %}\n        <div class=\"pf-terms pf-font-size\">\n            <p><strong class=\"pf-color\">Terms and conditions</strong></p>\n            <br>\n            <p>{{ doc.terms }}</p>\n        </div>\n    {% endif %}\n    \n{% set include_signature = print_format_shows_signature(\"Purchase Order - Standard\") %}\n{% if include_signature %}\n    {% set workflow_signatures = get_workflow_signatures_for_print(doc.doctype, doc.name) %}\n    {% if workflow_signatures and workflow_signatures|length > 0 %}\n    <div class=\"pf-signatures\" style=\"margin-top: 40px; margin-bottom: 25px; text-align: center;\">\n        {% for step in workflow_signatures %}\n        <div style=\"display: inline-block; vertical-align: top; text-align: center; width: 160px; margin: 0 15px 15px 15px;\">\n            <div style=\"font-weight: bold; font-size: 13px;\">{{ step.user }}</div>\n            <div style=\"font-size: 12px; color: #555;\">{{ step.workflow_state }}</div>\n            <div style=\"margin-top: 8px; min-height: 50px;\">\n                {% if step.signature %}\n                    <img src=\"{{ step.signature }}\" style=\"max-width: 120px; max-height: 60px;\">\n                {% else %}\n                    <span style=\"font-size: 11px; color: #999;\">No Signature</span>\n                {% endif %}\n            </div>\n        </div>\n        {% endfor %}\n    </div>\n    {% endif %}\n{% endif %}\n\n\n    \n</div>\n\n{% if footer %}\n\t<div class=\"text-center footer small\">\n\t\t    {{footer}}\n\t</div>\n{% endif %}\n",
