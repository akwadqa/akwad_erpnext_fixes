 "css": ".pf-item-table td {\n    border: 1px dashed black;\n    vertical-align: middle!important;\n}\n\n.pf-item-table th {\n    text-align: center;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Journal Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 50%;\">\n                    <p>Number # \u0627\u0644\u0631\u0642\u0645</p>\n                </td>\n                <td style=\"width: 50%;\">\n                    <p>{{ doc.name }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 50%;\">\n                    <p>Posting Date \u062a\u0627\u0631\u064a\u062e</p>\n                </td>\n                <td style=\"width: 50%;\">\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 50%;\">\n                    <p>Entry Type \u0646\u0648\u0639 \u0627\u0644\u0642\u064a\u062f</p>\n                </td>\n                <td style=\"width: 50%;\">\n                    <p>{{ doc.voucher_type }}</p>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"width: 5%;\">No.<br>\u0645</th>\n                <th style=\"width: 35%;\">Account<br>\u0627\u0644\u062d\u0633\u0627\u0628</th>\n                <th style=\"width: 20%;\">Remarks<br>\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a</th>\n                <th style=\"width: 20%;\">Credit<br>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062f\u0627\u0626\u0646\u0629</th>\n                <th style=\"width: 20%;\">Debit<br>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u062f\u064a\u0646\u0629</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for account in doc.accounts %}\n                <tr style=\"border: 3px solid {{ color }};\">\n                    <td>{{ account.idx }}</td>\n                    <td>\n                        <div>\n                            Account: {{ account.account }}\n                        </div>\n                        {% if account.cost_center %}\n                            <div style=\"border-top: 1px dashed black;\">\n                                Cost Center: {{ account.cost_center }}\n                            </div>\n                        {% endif %}\n                        {% if account.project %}\n                            <div style=\"border-top: 1px dashed black;\">\n                                Project: {{ frappe.db.get_value(\"Project\", account.project, \"project_name\") }}\n                            </div>\n                        {% endif %}\n                    </td>\n                    <td style=\"text-align: center;\">{{ account.user_remark }}</td>\n                    <td style=\"text-align: center;\">{{ account.get_formatted(\"credit_in_account_currency\", doc) or 0 }}</td>\n                    <td style=\"text-align: center;\">{{ account.get_formatted(\"debit_in_account_currency\", doc) or 0 }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n        <tr>\n            <td style=\"width: 70%;\"></td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                Total Credit: {{ doc.get_formatted(\"total_credit\") }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 70%;\"></td>\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                Total Debit: {{ doc.get_formatted(\"total_debit\") }}\n            </td>\n        </tr>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n        <tr>\n            <td rowspan=\"3\" style=\"width: 20%;\">\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.name }}&size=120x120\">\n            </td>\n            <td style=\"width: 10%;\">\n                \n            </td>\n            <td style=\"width: 25%; vertical-align: middle!important;\">\n                Reference # \u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639:\n            </td>\n            <td style=\"width: 45%; vertical-align: middle!important;\">\n                {{ doc.cheque_no }}\n            </td>\n        </tr>\n        <tr>\n            <td>\n                \n            </td>\n            <td style=\"vertical-align: middle!important;\">\n                Reference Date \u0627\u0644\u062a\u0627\u0631\u064a\u062e:\n            </td>\n            <td style=\"vertical-align: middle!important;\">\n                {{ doc.get_formatted(\"cheque_date\") }}\n            </td>\n        </tr>\n        <tr>\n            <td>\n                \n            </td>\n            <td style=\"vertical-align: middle!important;\">\n                Remarks \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a:\n            </td>\n            <td style=\"vertical-align: middle!important;\">\n                {{ doc.user_remark }}\n            </td>     \n        </tr>\n    </table>\n    \n    {% if footer %}\n        <div id=\"footer-html\" class=\"visible-pdf\">\n            {{ footer }}\n        </div>\n    {% endif %}\n    \n</div>",
